@inherits LayoutComponentBase
@inject IJSRuntime JS

<MudThemeProvider IsDarkMode="isDarkMode" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Fixed="false" Elevation="1">
        <MudText Typo="Typo.h6" Class="ma-0">
            <MudLink Href="/" Underline="Underline.None" Style="color: inherit">
                TimeMeet
            </MudLink>
        </MudText>

        <MudSpacer />

        <MudHidden Breakpoint="Breakpoint.Xs">
            <MudButton Href="/meetings"
                       Variant="Variant.Text"
                       Color="Color.Inherit"
                       StartIcon="@Icons.Material.Filled.List">
                Мои встречи
            </MudButton>
            <MudButton Href="/create"
                       Variant="Variant.Filled"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Add"
                       Class="ml-2">
                Создать встречу
            </MudButton>
        </MudHidden>

        <MudHidden Breakpoint="Breakpoint.SmAndUp">
            <MudMenu Icon="@Icons.Material.Filled.Menu"
                     Color="Color.Inherit"
                     AnchorOrigin="Origin.BottomRight"
                     TransformOrigin="Origin.TopRight">
                <MudMenuItem Href="/meetings"
                             Icon="@Icons.Material.Filled.List">
                    Мои встречи
                </MudMenuItem>
                <MudMenuItem Href="/create"
                             Icon="@Icons.Material.Filled.Add">
                    Создать встречу
                </MudMenuItem>
            </MudMenu>
        </MudHidden>

        <MudIconButton Icon="@(isDarkMode ? Icons.Material.Filled.LightMode : Icons.Material.Filled.DarkMode)"
                       Color="Color.Inherit"
                       aria-label="Переключить тему"
                       OnClick="ToggleTheme" />
    </MudAppBar>
    <MudMainContent Class="pa-4">
        @Body
    </MudMainContent>
</MudLayout>

<div id="blazor-error-ui" data-nosnippet>
    Произошла непредвиденная ошибка.
    <a href="." class="reload">Перезагрузить</a>
    <span class="dismiss">??</span>
</div>

@code {
    private bool isDarkMode;
    private const string ThemeStorageKey = "timemeet-theme-dark";
    private bool themeLoaded;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var savedTheme = await JS.InvokeAsync<string?>("localStorage.getItem", ThemeStorageKey);
            if (bool.TryParse(savedTheme, out var savedIsDarkMode))
            {
                isDarkMode = savedIsDarkMode;
            }
            else
            {
                isDarkMode = await JS.InvokeAsync<bool>("timeMeetTheme.prefersDark");
            }

            themeLoaded = true;
            StateHasChanged();
            return;
        }

        if (themeLoaded)
        {
            themeLoaded = false;
            await JS.InvokeVoidAsync("timeMeetTheme.show");
        }
    }

    private async Task ToggleTheme()
    {
        isDarkMode = !isDarkMode;
        await JS.InvokeVoidAsync("localStorage.setItem", ThemeStorageKey, isDarkMode.ToString());
    }
}

