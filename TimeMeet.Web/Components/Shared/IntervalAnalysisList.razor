@using System.Globalization
@using TimeMeet.Application.Meetings

<MudPaper Class="pa-4 mt-4">
    <MudText Typo="Typo.h6">Лучшие интервалы</MudText>
    @if (Items.Count == 0)
    {
        <MudText Color="Color.Secondary" Class="mt-2">@(HasVoted ? "Никто из проголосовавших не может участвовать ни в какое время." : "Пока никто не отметил доступность. Результаты появятся, когда кто-то проголосует.")</MudText>
    }
    else
    {
        <table class="mud-table-root mt-2">
            <thead>
                <tr>
                    <th>Начало</th>
                    <th>Окончание</th>
                    <th>Продолжительность</th>
                    <th>Доступность</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Items)
                {
                    <tr @onclick="@(() => Select(item))" style="cursor:pointer">
                        <td>@Format(item.StartTime)</td>
                        <td>@Format(item.EndTime)</td>
                        <td>@FormatDuration(item.Duration)</td>
                        <td>@FormatAvailability(item)</td>
                    </tr>
                }
            </tbody>
        </table>
        @if (selected is not null)
        {
            <MudPaper Class="pa-4 mt-3" Outlined="true">
                <MudText Typo="Typo.subtitle1">@Format(selected.StartTime) — @Format(selected.EndTime)</MudText>
                @foreach (var group in selected.ParticipantBreakdown.GroupBy(x => x.Name))
                {
                    <MudText Class="mt-2"><b>@group.Key:</b> @string.Join(", ", group.Select(FormatSegment))</MudText>
                }
                @if (ShowCloseButton)
                {
                    <MudButton Class="mt-3" Variant="Variant.Filled" Color="Color.Success" OnClick="CloseSelected">
                        Закрыть встречу с этим интервалом
                    </MudButton>
                }
            </MudPaper>
        }
    }
</MudPaper>

@code {
    [Parameter] public IReadOnlyCollection<IntervalAnalysis> Items { get; set; } = [];
    [Parameter] public bool HasVoted { get; set; }
    [Parameter] public bool ShowCloseButton { get; set; }
    [Parameter] public EventCallback<IntervalAnalysis> OnClose { get; set; }
    private IntervalAnalysis? selected;

    private void Select(IntervalAnalysis value) => selected = value;
    private Task CloseSelected() => selected is null ? Task.CompletedTask : OnClose.InvokeAsync(selected);
    private static string Format(DateTimeOffset value) => value.ToLocalTime().ToString("dd.MM.yyyy HH:mm", CultureInfo.GetCultureInfo("ru-RU"));
    private static string FormatDuration(TimeSpan value)
    {
        var parts = new List<string>();
        if (value.Days > 0) parts.Add($"{value.Days} {Plural(value.Days, "день", "дня", "дней")}");
        if (value.Hours > 0) parts.Add($"{value.Hours} {Plural(value.Hours, "час", "часа", "часов")}");
        if (value.Minutes > 0) parts.Add($"{value.Minutes} {Plural(value.Minutes, "минута", "минуты", "минут")}");
        return parts.Count == 0 ? "0 минут" : string.Join(" ", parts);
    }
    private static string Plural(int value, string one, string few, string many) => value % 10 == 1 && value % 100 != 11 ? one : value % 10 is >= 2 and <= 4 && (value % 100 < 10 || value % 100 >= 20) ? few : many;
    private static string FormatAvailability(IntervalAnalysis value) =>
        value.CannotCount == 0
            ? value.IfNeededCount == 0 ? "все доступны" : $"{value.AvailableCount} доступны, {value.IfNeededCount} если нужно"
            : value.AvailableCount > 0
                ? $"{value.AvailableCount} доступны, {(value.IfNeededCount > 0 ? $"{value.IfNeededCount} если нужно, " : "")}{value.CannotCount} не могут"
                : $"{value.IfNeededCount} если нужно, {value.CannotCount} не могут";
    private static string FormatSegment(ParticipantBreakdown value) => $"{Status(value.Status)} ({value.From.ToLocalTime():HH:mm}–{value.To.ToLocalTime():HH:mm})";
    private static string Status(string value) => value switch { "Available" => "доступен", "IfNeeded" => "если нужно", _ => "не может" };
}