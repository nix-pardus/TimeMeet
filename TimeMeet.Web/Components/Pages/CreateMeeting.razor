@page "/create"
@using System.ComponentModel.DataAnnotations
@using TimeMeet.Application.Meetings
@using TimeMeet.Domain.Enums
@inject IMeetingService MeetingService
@inject NavigationManager Navigation

<PageTitle>Создать встречу — TimeMeet</PageTitle>

<MudContainer MaxWidth="MaxWidth.Medium">
    <MudPaper Class="pa-6" Elevation="2">
        <MudText Typo="Typo.h4" GutterBottom="true">Создать встречу</MudText>
        <MudText Color="Color.Secondary" Class="mb-5">
            Сначала участники отметят доступность в свободной сетке, затем вы выберете варианты для финального голосования.
        </MudText>

        @if (!string.IsNullOrWhiteSpace(errorMessage))
        {
            <MudAlert Severity="Severity.Error" Class="mb-4">@errorMessage</MudAlert>
        }

        <EditForm Model="model" OnValidSubmit="CreateAsync">
            <DataAnnotationsValidator />
            <MudTextField @bind-Value="model.Title" Label="Название встречи" Required="true" For="@(() => model.Title)" Class="mb-3" />
            <MudTextField @bind-Value="model.OrganizerName" Label="Ваше имя" Required="true" For="@(() => model.OrganizerName)" Class="mb-3" />
            <MudTextField @bind-Value="model.Description" Label="Описание" Lines="3" Class="mb-3" />
            <MudTextField @bind-Value="model.TimeZone" Label="Часовой пояс организатора (IANA)" Required="true" HelperText="Например, Europe/Moscow" Class="mb-4" />

            <MudText Typo="Typo.h6" Class="mb-2">Диапазон свободной сетки</MudText>
            <MudGrid>
                <MudItem xs="12" sm="6"><MudDatePicker @bind-Date="model.StartDate" Label="Дата начала" Required="true" /></MudItem>
                <MudItem xs="12" sm="6"><MudDatePicker @bind-Date="model.EndDate" Label="Дата окончания" Required="true" /></MudItem>
                <MudItem xs="12" sm="6"><MudTextField @bind-Value="model.From" Label="Время начала дня" type="time" Required="true" /></MudItem>
                <MudItem xs="12" sm="6"><MudTextField @bind-Value="model.To" Label="Время окончания дня" type="time" Required="true" /></MudItem>
                <MudItem xs="12">
                    <MudSelect @bind-Value="model.Step" Label="Шаг сетки" Required="true">
                        <MudSelectItem Value="30">30 минут</MudSelectItem>
                        <MudSelectItem Value="60">60 минут</MudSelectItem>
                    </MudSelect>
                </MudItem>
            </MudGrid>

            <MudTextField @bind-Value="model.Deadline" Label="Дедлайн первой фазы (необязательно)" type="datetime-local" Class="mt-4" />

            <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" Size="Size.Large" Class="mt-4" Disabled="isSaving">
                @(isSaving ? "Создание…" : "Создать встречу")
            </MudButton>
        </EditForm>
    </MudPaper>
</MudContainer>

@code {
    private readonly CreateMeetingModel model = new();
    private string? errorMessage;
    private bool isSaving;

    private async Task CreateAsync()
    {
        errorMessage = null;
        isSaving = true;
        try
        {
            if (model.StartDate is null || model.EndDate is null || !TimeSpan.TryParse(model.From, out var from) || !TimeSpan.TryParse(model.To, out var to))
                throw new ArgumentException("Укажите корректный диапазон дат и времени.");

            var result = await MeetingService.CreateAsync(new CreateMeetingRequest
            {
                Title = model.Title,
                Description = model.Description,
                OrganizerName = model.OrganizerName,
                TimeZone = model.TimeZone,
                GridStartDate = DateOnly.FromDateTime(model.StartDate.Value),
                GridEndDate = DateOnly.FromDateTime(model.EndDate.Value),
                GridFrom = TimeOnly.FromTimeSpan(from),
                GridTo = TimeOnly.FromTimeSpan(to),
                GridStepMinutes = model.Step,
                 Deadline = ParseDeadline(model.Deadline, model.TimeZone),
            });

            Navigation.NavigateTo($"/manage-access/{result.Meeting.ShortCode}?token={Uri.EscapeDataString(result.OwnerToken)}", forceLoad: true);
        }
        catch (Exception exception) when (exception is ArgumentException or InvalidOperationException or TimeZoneNotFoundException)
        {
            errorMessage = exception.Message;
        }
        finally
        {
            isSaving = false;
        }
    }

    private static DateTimeOffset? ParseDeadline(string value, string timeZoneId)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return null;
        }

        if (!DateTime.TryParse(value, out var local))
        {
            throw new ArgumentException("Укажите корректный дедлайн.");
        }

        var zone = TimeZoneInfo.FindSystemTimeZoneById(timeZoneId);
        return new DateTimeOffset(TimeZoneInfo.ConvertTimeToUtc(DateTime.SpecifyKind(local, DateTimeKind.Unspecified), zone));
    }

    private sealed class CreateMeetingModel
    {
        [Required, StringLength(200)] public string Title { get; set; } = string.Empty;
        [Required, StringLength(100)] public string OrganizerName { get; set; } = string.Empty;
        public string? Description { get; set; }
        [Required] public string TimeZone { get; set; } = "Europe/Moscow";
        public DateTime? StartDate { get; set; } = DateTime.Today.AddDays(1);
        public DateTime? EndDate { get; set; } = DateTime.Today.AddDays(7);
        public string From { get; set; } = "09:00";
        public string To { get; set; } = "21:00";
        public int Step { get; set; } = 30;
        public string Deadline { get; set; } = string.Empty;
    }
}
