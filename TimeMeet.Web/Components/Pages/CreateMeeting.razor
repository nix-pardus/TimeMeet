@page "/create"
@using System.ComponentModel.DataAnnotations
@using TimeMeet.Application.Meetings
@using TimeMeet.Domain.Enums
@inject IMeetingService MeetingService
@inject NavigationManager Navigation

<PageTitle>Создать встречу — TimeMeet</PageTitle>

<MudContainer MaxWidth="MaxWidth.Medium">
    <MudPaper Class="pa-6" Elevation="2">
        <MudText Typo="Typo.h4" GutterBottom="true">Создать встречу</MudText>
        <MudText Color="Color.Secondary" Class="mb-5">
            Участники отметят доступность в свободной сетке, а организатор выберет итоговое время.
        </MudText>

        @if (!string.IsNullOrWhiteSpace(errorMessage))
        {
            <MudAlert Severity="Severity.Error" Class="mb-4">@errorMessage</MudAlert>
        }

        <EditForm Model="model" OnValidSubmit="CreateAsync">
            <DataAnnotationsValidator />
            <MudTextField @bind-Value="model.Title" Label="Название встречи" Required="true" For="@(() => model.Title)" Class="mb-3" />
            <MudTextField @bind-Value="model.OrganizerName" Label="Ваше имя" Required="true" For="@(() => model.OrganizerName)" Class="mb-3" />
            <MudTextField @bind-Value="model.Description" Label="Описание" Lines="3" Class="mb-3" />
            <MudTextField @bind-Value="model.TimeZone" Label="Часовой пояс организатора (IANA)" Required="true" HelperText="Например, Europe/Moscow" Class="mb-4" />

            <MudText Typo="Typo.h6" Class="mb-2">Свободная сетка</MudText>
            <MudGrid>
                <MudItem xs="12" sm="6"><MudDatePicker @bind-Date="model.StartDate" Label="Дата начала" Required="true" /></MudItem>
                <MudItem xs="12" sm="6"><MudDatePicker @bind-Date="model.EndDate" Label="Дата окончания" Required="true" /></MudItem>
                <MudItem xs="12">
                    <MudSelect @bind-Value="model.Step" Label="Шаг сетки" Required="true">
                        <MudSelectItem Value="15">15 минут</MudSelectItem>
                        <MudSelectItem Value="30">30 минут</MudSelectItem>
                        <MudSelectItem Value="60">60 минут</MudSelectItem>
                    </MudSelect>
                </MudItem>
                <MudItem xs="12">
                    <MudText Typo="Typo.subtitle2">Хранение встречи</MudText>
                    <MudRadioGroup @bind-Value="model.RetentionMode">
                        <MudRadio Value="@RetentionMode.KeepForever">Хранить историю встречи</MudRadio>
                        <MudRadio Value="@RetentionMode.DeleteAfterLastDay">Удалить через день после окончания</MudRadio>
                    </MudRadioGroup>
                </MudItem>
            </MudGrid>

            <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" Size="Size.Large" Class="mt-4" Disabled="isSaving">
                @(isSaving ? "Создание…" : "Создать встречу")
            </MudButton>
        </EditForm>
    </MudPaper>
</MudContainer>

@code {
    private readonly CreateMeetingModel model = new();
    private string? errorMessage;
    private bool isSaving;

    private async Task CreateAsync()
    {
        errorMessage = null;
        isSaving = true;
        try
        {
            if (model.StartDate is null || model.EndDate is null)
                throw new ArgumentException("Укажите диапазон дат.");

            var result = await MeetingService.CreateAsync(new CreateMeetingRequest
            {
                Title = model.Title,
                Description = model.Description,
                OrganizerName = model.OrganizerName,
                TimeZone = model.TimeZone,
                GridStartDate = DateOnly.FromDateTime(model.StartDate.Value),
                GridEndDate = DateOnly.FromDateTime(model.EndDate.Value),
                GridStepMinutes = model.Step,
                RetentionMode = model.RetentionMode
            });

            Navigation.NavigateTo($"/manage/{result.Meeting.ShortCode}?key={Uri.EscapeDataString(result.OwnerToken)}", forceLoad: true);
        }
        catch (Exception exception) when (exception is ArgumentException or InvalidOperationException or TimeZoneNotFoundException)
        {
            errorMessage = exception.Message;
        }
        finally
        {
            isSaving = false;
        }
    }

    private sealed class CreateMeetingModel
    {
        [Required, StringLength(100)] public string Title { get; set; } = string.Empty;
        [Required, StringLength(50)] public string OrganizerName { get; set; } = string.Empty;
        [StringLength(1000)] public string? Description { get; set; }
        [Required] public string TimeZone { get; set; } = "Europe/Moscow";
        public DateTime? StartDate { get; set; } = DateTime.Today.AddDays(1);
        public DateTime? EndDate { get; set; } = DateTime.Today.AddDays(7);
        public int Step { get; set; } = 30;
        public RetentionMode RetentionMode { get; set; } = RetentionMode.KeepForever;
    }
}
