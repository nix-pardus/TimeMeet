@page "/create"
@using System.ComponentModel.DataAnnotations
@using TimeMeet.Application.Meetings
@using TimeMeet.Domain.Enums
@inject IMeetingService MeetingService
@inject NavigationManager Navigation

<PageTitle>Создать встречу — TimeMeet</PageTitle>

<MudContainer MaxWidth="MaxWidth.Medium">
    <MudPaper Class="pa-6" Elevation="2">
        <MudText Typo="Typo.h4" GutterBottom="true">Найти общее время</MudText>
            <MudText Color="Color.Tertiary" Class="mb-5">
                Поделитесь ссылкой с участниками — они отметят, когда им удобно. Затем вы выберете итоговое время.
        </MudText>

        @if (!string.IsNullOrWhiteSpace(errorMessage))
        {
            <MudAlert Severity="Severity.Error" Class="mb-4">@errorMessage</MudAlert>
        }

        <EditForm Model="model" OnValidSubmit="CreateAsync">
            <DataAnnotationsValidator />
            <MudTextField @bind-Value="model.Title" Label="Название события" Required="true" For="@(() => model.Title)" Class="mb-3" />
            <MudTextField @bind-Value="model.OrganizerName" Label="Ваше имя" Required="true" For="@(() => model.OrganizerName)" Class="mb-3" />
            <MudTextField @bind-Value="model.Password" Label="Пароль (необязательно)" InputType="InputType.Password" HelperText="Минимум 4 символа. Пароль нужен для восстановления доступа." Class="mb-4" />

            <MudText Typo="Typo.h6" Class="mb-2">На какие дни ищем время</MudText>
            <MudGrid>
                <MudItem xs="12" sm="6"><MudDatePicker @bind-Date="model.StartDate" Label="Дата начала" Required="true" /></MudItem>
                <MudItem xs="12" sm="6"><MudDatePicker @bind-Date="model.EndDate" Label="Дата окончания" Required="true" /></MudItem>
                <MudItem xs="12">
                    <MudSelect @bind-Value="model.Step" Label="Шаг времени" Required="true">
                        <MudSelectItem Value="15">15 минут</MudSelectItem>
                        <MudSelectItem Value="30">30 минут</MudSelectItem>
                        <MudSelectItem Value="60">60 минут</MudSelectItem>
                    </MudSelect>
                </MudItem>
            </MudGrid>

            <MudExpansionPanels Class="mt-4">
                <MudExpansionPanel Text="Дополнительные параметры">
                    <MudTextField @bind-Value="model.Description" Label="Описание" Lines="3" Class="mb-3" />
                    <MudTextField @bind-Value="model.TimeZone" Label="Часовой пояс" Required="true" HelperText="Например, Europe/Moscow" Class="mb-4" />

                    <MudRadioGroup T="RetentionMode" @bind-Value="model.RetentionMode">
                        <MudText Typo="Typo.subtitle2">Хранение встречи</MudText>
                        <MudRadio T="RetentionMode" Value="RetentionMode.KeepForever">
                            Хранить историю встречи
                        </MudRadio>
                        <MudRadio T="RetentionMode" Value="RetentionMode.DeleteAfterLastDay">
                            Удалить через день после окончания
                        </MudRadio>
                    </MudRadioGroup>
                </MudExpansionPanel>
            </MudExpansionPanels>

            <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" Size="Size.Large" Class="mt-4" Disabled="isSaving">
                @(isSaving ? "Создание…" : "Создать встречу")
            </MudButton>
        </EditForm>
    </MudPaper>
</MudContainer>

@code {
    private readonly CreateMeetingModel model = new();
    private string? errorMessage;
    private bool isSaving;

    private async Task CreateAsync()
    {
        errorMessage = null;
        isSaving = true;
        try
        {
            if (model.StartDate is null || model.EndDate is null)
                throw new ArgumentException("Укажите корректный диапазон дат.");

            var result = await MeetingService.CreateAsync(new CreateMeetingRequest
            {
                Title = model.Title,
                Description = model.Description,
                OrganizerName = model.OrganizerName,
                TimeZone = model.TimeZone,
                GridStartDate = DateOnly.FromDateTime(model.StartDate.Value),
                GridEndDate = DateOnly.FromDateTime(model.EndDate.Value),
                GridStepMinutes = model.Step,
                RetentionMode = model.RetentionMode,
                OrganizerPassword = string.IsNullOrWhiteSpace(model.Password) ? null : model.Password
            });

            Navigation.NavigateTo($"/manage-access/{result.Meeting.ShortCode}?token={Uri.EscapeDataString(result.OwnerToken)}&participantToken={Uri.EscapeDataString(result.OrganizerParticipantToken)}", forceLoad: true);
        }
        catch (Exception exception) when (exception is ArgumentException or InvalidOperationException or TimeZoneNotFoundException)
        {
            errorMessage = exception.Message;
        }
        finally
        {
            isSaving = false;
        }
    }

    private sealed class CreateMeetingModel
    {
        [Required, StringLength(100)] public string Title { get; set; } = string.Empty;
        [Required, StringLength(100)] public string OrganizerName { get; set; } = string.Empty;
        public string? Description { get; set; }
        [Required] public string TimeZone { get; set; } = "Europe/Moscow";
        public string? Password { get; set; }
        public DateTime? StartDate { get; set; } = DateTime.Today.AddDays(1);
        public DateTime? EndDate { get; set; } = DateTime.Today.AddDays(7);
        public int Step { get; set; } = 30;
        public RetentionMode RetentionMode { get; set; } = RetentionMode.KeepForever;
    }
}
