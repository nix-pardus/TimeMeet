@page "/manage/{ShortCode}"
@using TimeMeet.Application.Meetings
@using TimeMeet.Domain.Entities
@using TimeMeet.Domain.Enums
@inject IMeetingService MeetingService
@inject IHttpContextAccessor HttpContextAccessor
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime

<PageTitle>Панель встречи — TimeMeet</PageTitle>
<MudContainer MaxWidth="MaxWidth.Large">
@if (isLoading) { <MudSkeleton Height="240px" /> }
else if (!string.IsNullOrWhiteSpace(errorMessage)) { <MudAlert Severity="Severity.Error">@errorMessage</MudAlert> }
else if (meeting is not null) {
    <MudText Typo="Typo.h4">@meeting.Title</MudText>
    <MudText Color="Color.Secondary" Class="mb-4">@GetStatusText(meeting.Status) · @(meeting.Phase == MeetingPhase.AvailabilityCollection ? "Сбор доступности" : "Финальное голосование")</MudText>
    <MudPaper Class="pa-4 mb-4"><MudText Typo="Typo.h6">Ссылка для участников</MudText><MudTextField Value="@ParticipantUrl" ReadOnly="true" /><MudText Typo="Typo.caption">Участников: @meeting.Participants.Count · Часовой пояс: @meeting.TimeZone</MudText></MudPaper>
    @if (meeting.Phase == MeetingPhase.AvailabilityCollection && meeting.Status == MeetingStatus.Active) {
        <MudPaper Class="pa-4"><MudText Typo="Typo.h6">Лучшие интервалы</MudText><MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="AnalyzeAsync" Disabled="isBusy">Найти общие интервалы</MudButton>
        @if (analysis.Count > 0) {
            <MudText Class="mt-3">Выбрано: @selectedCells.Count из 2–5</MudText>
            <MudTable Items="analysis" Hover="true" Dense="true" Class="mt-2"><HeaderContent><MudTh>Выбор</MudTh><MudTh>Время</MudTh><MudTh>Свободны</MudTh><MudTh>Если нужно</MudTh><MudTh>Не могут</MudTh><MudTh>Рейтинг</MudTh></HeaderContent><RowTemplate><MudTd><MudCheckBox T="bool" Value="@selectedCells.Contains(context.Cell.Id)" ValueChanged="@(value => ToggleCell(context.Cell.Id, value))" /></MudTd><MudTd>@Format(context.Cell.StartTime) — @Format(context.Cell.EndTime)</MudTd><MudTd>@context.AvailableCount</MudTd><MudTd>@context.IfNeededCount</MudTd><MudTd>@context.UnavailableCount</MudTd><MudTd>@context.Score</MudTd></RowTemplate></MudTable>
            <MudButton Class="mt-3" Variant="Variant.Filled" Color="Color.Success" OnClick="StartFinalAsync" Disabled="@(selectedCells.Count is < 2 or > 5 || isBusy)">Создать финальное голосование</MudButton>
        }
        </MudPaper>
    }
    @if (meeting.Phase == MeetingPhase.FinalSlotSelection) {
        <MudPaper Class="pa-4"><MudText Typo="Typo.h6">Финальные варианты</MudText><MudTable Items="meeting.TimeSlots.OrderBy(x => x.StartTime)" Dense="true"><HeaderContent><MudTh>Выбор</MudTh><MudTh>Время</MudTh></HeaderContent><RowTemplate><MudTd><MudRadio T="Guid" Group="final-slot" Value="@context.Id" @bind-Checked="selectedSlotId" /></MudTd><MudTd>@Format(context.StartTime) — @Format(context.EndTime)</MudTd></RowTemplate></MudTable><MudButton Class="mt-3" Variant="Variant.Filled" Color="Color.Success" OnClick="CloseAsync" Disabled="@(selectedSlotId == Guid.Empty || isBusy)">Закрыть голосование</MudButton></MudPaper>
    }
    @if (meeting.Status == MeetingStatus.Closed && meeting.SelectedTimeSlotId is not null) { <MudAlert Severity="Severity.Success" Class="mt-4">Встреча закрыта. Итоговый слот выбран.</MudAlert> }
}
</MudContainer>

@code {
    [Parameter] public string ShortCode { get; set; } = string.Empty;
    private Meeting? meeting; private IReadOnlyCollection<GridCellAnalysis> analysis = []; private readonly HashSet<Guid> selectedCells = []; private Guid selectedSlotId; private bool isLoading = true; private bool isBusy; private string? errorMessage; private string? ownerToken;
    private string ParticipantUrl => Navigation.ToAbsoluteUri($"/m/{ShortCode}").ToString();
    protected override async Task OnInitializedAsync() { ownerToken = HttpContextAccessor.HttpContext?.Request.Cookies[$"timemeet-owner-{ShortCode}"]; if (string.IsNullOrWhiteSpace(ownerToken)) { errorMessage = "Панель доступна только организатору."; isLoading = false; return; } meeting = await MeetingService.GetForOwnerAsync(ShortCode, ownerToken); if (meeting is null) errorMessage = "Встреча не найдена или ссылка управления недействительна."; isLoading = false; }
    private async Task AnalyzeAsync() { try { isBusy = true; analysis = await MeetingService.AnalyzeAvailabilityAsync(ShortCode, ownerToken!); } catch (Exception ex) when (ex is ArgumentException or InvalidOperationException or UnauthorizedAccessException) { errorMessage = ex.Message; } finally { isBusy = false; } }
    private void ToggleCell(Guid id, bool selected) { if (selected) { if (selectedCells.Count < 5) selectedCells.Add(id); } else selectedCells.Remove(id); }
    private async Task StartFinalAsync() { try { isBusy = true; await MeetingService.StartFinalPhaseAsync(ShortCode, ownerToken!, new FinalPhaseRequest(selectedCells.ToArray(), null)); meeting = await MeetingService.GetForOwnerAsync(ShortCode, ownerToken!); } catch (Exception ex) when (ex is ArgumentException or InvalidOperationException or UnauthorizedAccessException) { errorMessage = ex.Message; } finally { isBusy = false; } }
    private async Task CloseAsync() { try { isBusy = true; await MeetingService.CloseAsync(ShortCode, ownerToken!, selectedSlotId); meeting = await MeetingService.GetForOwnerAsync(ShortCode, ownerToken!); } catch (Exception ex) when (ex is ArgumentException or InvalidOperationException or UnauthorizedAccessException) { errorMessage = ex.Message; } finally { isBusy = false; } }
    private string Format(DateTimeOffset value) => value.ToLocalTime().ToString("dd.MM.yyyy HH:mm");
    private static string GetStatusText(MeetingStatus status) => status switch { MeetingStatus.Active => "Активна", MeetingStatus.Closed => "Закрыта", MeetingStatus.Archived => "Архивирована", _ => "Черновик" };
}
