@page "/manage/{ShortCode}"
@using TimeMeet.Application.Meetings
@using TimeMeet.Domain.Entities
@using TimeMeet.Domain.Enums
@inject IMeetingService MeetingService
@inject IHttpContextAccessor HttpContextAccessor
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime
@inject IMeetingQrCodeGenerator QrCodeGenerator

<PageTitle>Управление встречей в TimeMeet</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large">
    @if (isLoading)
    {
        <MudSkeleton Height="240px" />
    }
    else if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <MudAlert Severity="Severity.Error">@errorMessage</MudAlert>
    }
    else if (meeting is not null)
    {
        <MudText Typo="Typo.h4">@meeting.Title</MudText>
        <MudText Color="Color.Secondary" Class="mb-4">
            @GetStatusText(meeting.Status)
        </MudText>

        <MudPaper Class="pa-4 mb-4">
            <MudText Typo="Typo.h6">Ссылка для участников</MudText>
            <MudTextField Value="@ParticipantUrl" ReadOnly="true" />
            <MudText Typo="Typo.caption">
                Участников: @meeting.Participants.Count · Часовой пояс: @meeting.TimeZone
            </MudText>
        </MudPaper>

        @if (meeting.Status == MeetingStatus.Active)
        {
            <MudPaper Class="pa-4">
                <MudText Typo="Typo.h6">Анализ доступности</MudText>

                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           OnClick="AnalyzeAsync"
                           Disabled="isBusy">
                    Найти лучшие интервалы
                </MudButton>

                @if (analysis.Count > 0)
                {
                    <MudTable Items="analysis"
                              Hover="true"
                              Dense="true"
                              Class="mt-2">
                        <HeaderContent>
                            <MudTh>Время</MudTh>
                            <MudTh>Доступны</MudTh>
                            <MudTh>Если нужно</MudTh>
                            <MudTh>Не могут</MudTh>
                            <MudTh>Оценка</MudTh>
                            <MudTh>Действие</MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd>
                                @Format(context.Cell.StartTime) — @Format(context.Cell.EndTime)
                            </MudTd>
                            <MudTd>@context.AvailableCount</MudTd>
                            <MudTd>@context.IfNeededCount</MudTd>
                            <MudTd>@context.CannotCount</MudTd>
                            <MudTd>@context.Score</MudTd>
                            <MudTd>
                                <MudButton Size="Size.Small"
                                           Color="Color.Success"
                                           OnClick="@(() => CloseWithCellAsync(context.Cell))"
                                           Disabled="isBusy">
                                    Выбрать
                                </MudButton>
                            </MudTd>
                        </RowTemplate>
                    </MudTable>
                }

                <MudButton Class="mt-3"
                           Variant="Variant.Outlined"
                           Color="Color.Warning"
                           OnClick="CloseWithoutSelectionAsync"
                           Disabled="isBusy">
                    Закрыть без выбранного времени
                </MudButton>

                @if (!string.IsNullOrWhiteSpace(qrCodeDataUri))
                {
                    <MudPaper Class="pa-4 mt-4">
                        <MudText Typo="Typo.h6">Ссылка для участников</MudText>
                        <MudTextField Value="@ParticipantUrl" ReadOnly="true" />
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3" Class="mt-3">
                            <img src="@qrCodeDataUri" alt="QR-код ссылки встречи" width="180" height="180" />
                            <MudStack Spacing="2">
                                <MudButton Variant="Variant.Outlined" OnClick="CopyMeetingLinkAsync">
                                    Скопировать ссылку
                                </MudButton>
                                <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="1">
                                    <MudButton Href="@TelegramShareUrl" Target="_blank" Variant="Variant.Outlined">Telegram</MudButton>
                                    <MudButton Href="@WhatsAppShareUrl" Target="_blank" Variant="Variant.Outlined">WhatsApp</MudButton>
                                    <MudButton Href="@VkShareUrl" Target="_blank" Variant="Variant.Outlined">ВКонтакте</MudButton>
                                    <MudButton Href="@EmailShareUrl" Variant="Variant.Outlined">Email</MudButton>
                                </MudStack>
                            </MudStack>
                        </MudStack>
                        @if (!string.IsNullOrWhiteSpace(shareMessage))
                        {
                            <MudText Typo="Typo.caption" Color="Color.Success">@shareMessage</MudText>
                        }
                    </MudPaper>
                }
            </MudPaper>
        }

        @if (meeting.Status == MeetingStatus.Closed)
        {
            <MudAlert Severity="Severity.Success" Class="mt-4">
                @(meeting.SelectedStartTime is null
                    ? "Встреча закрыта без выбранного времени."
                    : $"Итог: {Format(meeting.SelectedStartTime.Value)} — {Format(meeting.SelectedEndTime!.Value)}")
            </MudAlert>

        }

        @if (meeting.Status is MeetingStatus.Active or MeetingStatus.Closed)
        {
            <MudPaper Class="pa-4 mt-4">
                <MudText Typo="Typo.h6">Управление хранением</MudText>
                <MudText Class="mb-2">
                    Режим хранения: @GetRetentionText(meeting.RetentionMode)
                </MudText>
                <MudButton Variant="Variant.Outlined"
                           Color="Color.Warning"
                           OnClick="ArchiveAsync"
                           Disabled="isBusy">
                    Архивировать встречу
                </MudButton>
                <MudButton Variant="Variant.Outlined"
                           Color="Color.Error"
                           Class="ml-2"
                           OnClick="DeleteAsync"
                           Disabled="isBusy">
                    Удалить встречу
                </MudButton>
            </MudPaper>
        }
    }
</MudContainer>

@code {
    [Parameter]
    public string ShortCode { get; set; } = string.Empty;

    private Meeting? meeting;
    private IReadOnlyCollection<GridCellAnalysis> analysis = [];
    private bool isLoading = true;
    private bool isBusy;
    private string? errorMessage;
    private string? ownerToken;
    private string? qrCodeDataUri;
    private string? shareMessage;

    private string ParticipantUrl =>
        Navigation.ToAbsoluteUri($"/m/{ShortCode}").ToString();

    private string ShareText => Uri.EscapeDataString($"Приглашаю на встречу: {meeting?.Title ?? "TimeMeet"}");
    private string EncodedParticipantUrl => Uri.EscapeDataString(ParticipantUrl);
    private string TelegramShareUrl => $"https://t.me/share/url?url={EncodedParticipantUrl}&text={ShareText}";
    private string WhatsAppShareUrl => $"https://wa.me/?text={ShareText}%20{EncodedParticipantUrl}";
    private string VkShareUrl => $"https://vk.com/share.php?url={EncodedParticipantUrl}&title={ShareText}";
    private string EmailShareUrl => $"mailto:?subject={ShareText}&body={EncodedParticipantUrl}";

    protected override async Task OnInitializedAsync()
    {
        ownerToken = HttpContextAccessor.HttpContext?.Request.Cookies[$"timemeet-owner-{ShortCode}"];

        if (string.IsNullOrWhiteSpace(ownerToken))
        {
            errorMessage = "Ссылка владельца недействительна.";
            isLoading = false;
            return;
        }

        meeting = await MeetingService.GetForOwnerAsync(ShortCode, ownerToken);

        if (meeting is null)
        {
            errorMessage = "Встреча не найдена или доступ организатора недействителен.";
        }

        await RefreshQrCodeAsync();

        isLoading = false;
    }

    private Task RefreshQrCodeAsync()
    {
        qrCodeDataUri = null;
        if (meeting?.Status == MeetingStatus.Active)
        {
            var bytes = QrCodeGenerator.Generate(ParticipantUrl);
            qrCodeDataUri = $"data:image/png;base64,{Convert.ToBase64String(bytes)}";
        }

        return Task.CompletedTask;
    }

    private async Task CopyMeetingLinkAsync()
    {
        await JSRuntime.InvokeVoidAsync("navigator.clipboard.writeText", ParticipantUrl);
        shareMessage = "Ссылка скопирована.";
    }

    private async Task AnalyzeAsync()
    {
        try
        {
            isBusy = true;
            analysis = await MeetingService.AnalyzeAvailabilityAsync(ShortCode, ownerToken!);
        }
        catch (Exception ex) when (
            ex is ArgumentException
            or InvalidOperationException
            or UnauthorizedAccessException)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isBusy = false;
        }
    }

    private Task ArchiveAsync() => ChangeRetentionAsync(MeetingService.ArchiveAsync);

    private async Task DeleteAsync()
    {
        if (!await JSRuntime.InvokeAsync<bool>("confirm", "Удалить встречу? Участники увидят, что организатор удалил встречу."))
        {
            return;
        }

        await ChangeRetentionAsync(MeetingService.DeleteAsync);
    }

    private async Task ChangeRetentionAsync(
        Func<string, string, CancellationToken, Task> operation)
    {
        try
        {
            isBusy = true;
            await operation(ShortCode, ownerToken!, CancellationToken.None);
            meeting = await MeetingService.GetForOwnerAsync(ShortCode, ownerToken!);
        }
        catch (Exception ex) when (
            ex is ArgumentException
            or InvalidOperationException
            or UnauthorizedAccessException)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isBusy = false;
        }
    }

    private Task CloseWithCellAsync(GridCell cell) =>
        CloseAsync(cell.StartTime, cell.EndTime);

    private Task CloseWithoutSelectionAsync() =>
        CloseAsync(null, null);

    private async Task CloseAsync(DateTimeOffset? start, DateTimeOffset? end)
    {
        try
        {
            isBusy = true;

            await MeetingService.CloseAsync(ShortCode, ownerToken!, start, end);
            meeting = await MeetingService.GetForOwnerAsync(ShortCode, ownerToken!);
            await RefreshQrCodeAsync();
        }
        catch (Exception ex) when (
            ex is ArgumentException
            or InvalidOperationException
            or UnauthorizedAccessException)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isBusy = false;
        }
    }

    private string Format(DateTimeOffset value) =>
        value.ToLocalTime().ToString("dd.MM.yyyy HH:mm");

    private static string GetStatusText(MeetingStatus status) =>
        status switch
        {
            MeetingStatus.Active => "Активна",
            MeetingStatus.Closed => "Закрыта",
            MeetingStatus.Archived => "Архивирована",
            MeetingStatus.Deleted => "Удалена",
            _ => status.ToString()
        };

    private static string GetRetentionText(RetentionMode mode) =>
        mode == RetentionMode.DeleteAfterLastDay
            ? "Удалить после последнего дня"
            : "Хранить постоянно";
}