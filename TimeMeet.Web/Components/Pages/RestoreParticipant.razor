@page "/m/{ShortCode}/restore"
@using System.ComponentModel.DataAnnotations
@using System.Net
@using System.Net.Http.Json
@using TimeMeet.Application.Meetings
@using TimeMeet.Domain.Enums
@inject IMeetingService MeetingService
@inject NavigationManager Navigation
@inject HttpClient Http

<PageTitle>Восстановление доступа — TimeMeet</PageTitle>

<MudContainer MaxWidth="MaxWidth.Small">
    <MudPaper Class="pa-6" Elevation="2">
        <MudText Typo="Typo.h5" GutterBottom="true">Восстановить доступ</MudText>
        <MudText Color="Color.Secondary" Class="mb-4">
            Введите имя и пароль, указанные при первом входе.
        </MudText>

        @if (isLoading)
        {
            <MudSkeleton Height="120px" />
        }
        else if (!string.IsNullOrWhiteSpace(loadError))
        {
            <MudAlert Severity="Severity.Error" Class="mb-4">@loadError</MudAlert>
            <MudButton Href="@MeetingUrl" Variant="Variant.Outlined" Color="Color.Primary">
                К странице встречи
            </MudButton>
        }
        else
        {
            <EditForm Model="model" OnValidSubmit="RestoreAsync">
                <DataAnnotationsValidator />
                @if (!string.IsNullOrWhiteSpace(errorMessage))
                {
                    <MudAlert Severity="Severity.Error" Class="mb-3">@errorMessage</MudAlert>
                }
                <MudTextField @bind-Value="model.DisplayName" Label="Ваше имя" Required="true" />
                <MudTextField @bind-Value="model.Password" Label="Пароль" InputType="InputType.Password" Required="true" />
                <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" Class="mt-4" Disabled="isBusy">
                    @(isBusy ? "Проверка…" : "Войти")
                </MudButton>
            </EditForm>

            <MudDivider Class="my-4" />
            <MudText Typo="Typo.body2">
                Впервые здесь? <MudLink Href="@MeetingUrl">Вернуться к встрече</MudLink>
            </MudText>
        }
    </MudPaper>
</MudContainer>

@code {
    [Parameter] public string ShortCode { get; set; } = string.Empty;

    private readonly RestoreModel model = new();
    private string? errorMessage;
    private string? loadError;
    private bool isBusy;
    private bool isLoading = true;

    private string MeetingUrl => $"/m/{Uri.EscapeDataString(ShortCode)}";

    protected override async Task OnInitializedAsync()
    {
        var access = await MeetingService.GetForParticipantAsync(ShortCode, null);
        if (access is null)
        {
            loadError = "Встреча не найдена.";
        }
        else if (access.Meeting.Status != MeetingStatus.Active)
        {
            loadError = access.Meeting.Status switch
            {
                MeetingStatus.Deleted => "Встреча удалена. Восстановление недоступно.",
                MeetingStatus.Archived => "Встреча архивирована. Восстановление недоступно.",
                _ => "Голосование закрыто. Восстановление недоступно."
            };
        }
        isLoading = false;
    }

    private async Task RestoreAsync()
    {
        errorMessage = null;
        isBusy = true;
        try
        {
            var response = await Http.PostAsJsonAsync(
                $"/api/m/{Uri.EscapeDataString(ShortCode)}/restore",
                new ParticipantRestoreRequest(model.DisplayName, model.Password));

            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<RestoreApiResponse>();
                Navigation.NavigateTo(result!.RedirectUrl, forceLoad: true);
                return;
            }

            errorMessage = response.StatusCode switch
            {
                HttpStatusCode.Unauthorized => "Неверное имя или пароль.",
                HttpStatusCode.TooManyRequests => "Слишком много попыток. Попробуйте позже.",
                HttpStatusCode.BadRequest => "Встреча не найдена.",
                _ => "Не удалось восстановить доступ. Попробуйте ещё раз."
            };
        }
        catch (HttpRequestException)
        {
            errorMessage = "Ошибка сети. Попробуйте ещё раз.";
        }
        finally
        {
            isBusy = false;
        }
    }

    private sealed class RestoreModel
    {
        [Required] public string DisplayName { get; set; } = string.Empty;
        [Required] public string Password { get; set; } = string.Empty;
    }
}