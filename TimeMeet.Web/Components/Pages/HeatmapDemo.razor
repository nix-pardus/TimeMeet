@page "/heatmap-demo"
@using TimeMeet.Domain.Entities
@using TimeMeet.Domain.Enums
@using TimeMeet.Web.Components.Shared

<PageTitle>Отладка тепловой карты — TimeMeet</PageTitle>

<div class="tm-app">
    <header class="tm-header">
        <h1>TimeMeet</h1>
        <span class="tm-tag">отладка: новая тепловая карта</span>
    </header>

    <div class="tm-heatmaps">
        <section class="tm-card">
            <div class="tm-card-head">
                <h2>Моя доступность</h2>
                <span class="tm-hint">Клик: не отмечено → свободен → если нужно</span>
            </div>
            <HeatmapView Meeting="demoMeeting"
                         Editable="true"
                         DisplayTimeZone="@demoMeeting.TimeZone"
                         HasVoted="myStatuses.Count > 0"
                         MyStatuses="myStatuses"
                         OnCellClick="OnCellClick" />
            <div class="tm-legend">
                <span><i class="sw sw-avail"></i>Свободен</span>
                <span><i class="sw sw-if-needed"></i>Если нужно</span>
                <span><i class="sw sw-unmarked"></i>Не отмечено</span>
            </div>
        </section>

        <section class="tm-card">
            <div class="tm-card-head">
                <h2>Показать всех</h2>
                <span class="tm-hint">3 участника + вы</span>
            </div>
            <HeatmapView Meeting="demoMeeting"
                         Editable="false"
                         DisplayTimeZone="@demoMeeting.TimeZone"
                         HasVoted="myStatuses.Count > 0"
                         MyStatuses="myStatuses" />
            <div class="tm-legend">
                <span><i class="sw sw-avail"></i>Свободен</span>
                <span><i class="sw sw-if-needed"></i>Если нужно</span>
                <span><i class="sw sw-mixed"></i>Смешанный</span>
            </div>
        </section>
    </div>
</div>

@code {
    private Meeting demoMeeting = null!;
    private readonly Dictionary<Guid, AvailabilityStatus> myStatuses = new();

    protected override void OnInitialized()
    {
        demoMeeting = DemoMeetingFactory.Create();
    }

    private void OnCellClick(Guid cellId)
    {
        if (!myStatuses.TryGetValue(cellId, out var current))
        {
            myStatuses[cellId] = AvailabilityStatus.Available;
        }
        else if (current == AvailabilityStatus.Available)
        {
            myStatuses[cellId] = AvailabilityStatus.IfNeeded;
        }
        else
        {
            myStatuses.Remove(cellId);
        }
    }
}