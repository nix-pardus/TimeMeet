@page "/meetings"
@using System.Globalization
@using TimeMeet.Application.Meetings
@using TimeMeet.Domain.Entities
@using TimeMeet.Domain.Enums
@inject IMeetingService MeetingService
@inject IHttpContextAccessor HttpContextAccessor
@inject IJSRuntime JSRuntime

<PageTitle>Мои встречи — TimeMeet</PageTitle>

<MudContainer MaxWidth="MaxWidth.Medium">
    <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-4">
        <MudText Typo="Typo.h4">Мои встречи</MudText>
        <MudSpacer />
        <MudButton Href="/create"
                   Variant="Variant.Filled"
                   Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Add">
            Создать встречу
        </MudButton>
    </MudStack>

    @if (isLoading)
    {
        <MudSkeleton Height="120px" Class="mb-3" />
        <MudSkeleton Height="120px" Class="mb-3" />
        <MudSkeleton Height="120px" />
    }
    else if (meetings.Count == 0)
    {
        <MudPaper Class="pa-8" Elevation="1" Style="text-align:center">
            <MudText Typo="Typo.body1" Class="mb-4">Вы пока не создали ни одной встречи.</MudText>
            <MudButton Href="/create"
                       Variant="Variant.Filled"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Add">
                Создать встречу
            </MudButton>
        </MudPaper>
    }
    else
    {
        @foreach (var item in meetings)
        {
            var subtitle = FormatGridRange(item.Meeting.GridStartDate, item.Meeting.GridEndDate)
                + " · " + FormatParticipantsCount(item.Meeting.Participants.Count);
            if (item.Meeting.Status == MeetingStatus.Closed && item.Meeting.SelectedStartTime is not null)
            {
                subtitle += " · Итог: " + FormatSelectedInterval(item.Meeting);
            }

            <MudPaper Class="pa-4 mb-3" Elevation="1">
                <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-2">
                    <MudText Typo="Typo.h6">@item.Meeting.Title</MudText>
                    <MudSpacer />
                    <MudChip T="string" Size="Size.Small" Color="@StatusColor(item.Meeting.Status)">
                        @GetStatusText(item.Meeting.Status)
                    </MudChip>
                </MudStack>

                <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-3">@subtitle</MudText>

                <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="1">
                    <MudButton Href="@($"/manage/{Uri.EscapeDataString(item.Meeting.ShortCode)}")"
                               Variant="Variant.Filled"
                               Color="Color.Primary"
                               Size="Size.Small"
                               StartIcon="@Icons.Material.Filled.Settings">
                        Управление
                    </MudButton>

                    @if (item.Meeting.Status == MeetingStatus.Active)
                    {
                        <MudButton Href="@($"/m/{Uri.EscapeDataString(item.Meeting.ShortCode)}")"
                                   Variant="Variant.Outlined"
                                   Color="Color.Primary"
                                   Size="Size.Small"
                                   StartIcon="@Icons.Material.Filled.Groups">
                            Голосование
                        </MudButton>
                    }

                    @if (item.Meeting.Status is MeetingStatus.Active or MeetingStatus.Closed)
                    {
                        <MudButton Variant="Variant.Outlined"
                                   Color="Color.Error"
                                   Size="Size.Small"
                                   StartIcon="@Icons.Material.Filled.Delete"
                                   OnClick="@(() => DeleteAsync(item))">
                            Удалить
                        </MudButton>
                    }
                </MudStack>
            </MudPaper>
        }
    }
</MudContainer>

@code {
    private const string OwnerCookiePrefix = "timemeet-owner-";
    private static readonly CultureInfo RussianCulture = CultureInfo.GetCultureInfo("ru-RU");
    private readonly List<MeetingWithToken> meetings = [];
    private bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        var cookies = HttpContextAccessor.HttpContext?.Request.Cookies;
        if (cookies is null)
        {
            isLoading = false;
            return;
        }

        foreach (var key in cookies.Keys)
        {
            if (!key.StartsWith(OwnerCookiePrefix, StringComparison.Ordinal))
                continue;

            var shortCode = key[OwnerCookiePrefix.Length..];
            var ownerToken = cookies[key];
            if (string.IsNullOrWhiteSpace(ownerToken))
                continue;

            var meeting = await MeetingService.GetForOwnerAsync(shortCode, ownerToken);
            if (meeting is null || meeting.Status == MeetingStatus.Deleted)
                continue;

            meetings.Add(new MeetingWithToken(meeting, ownerToken));
        }

        meetings.Sort((a, b) => b.Meeting.CreatedAt.CompareTo(a.Meeting.CreatedAt));
        isLoading = false;
    }

    private async Task DeleteAsync(MeetingWithToken item)
    {
        if (!await JSRuntime.InvokeAsync<bool>(
                "confirm",
                $"Удалить встречу «{item.Meeting.Title}»? Участники увидят, что организатор удалил встречу."))
        {
            return;
        }

        try
        {
            await MeetingService.DeleteAsync(item.Meeting.ShortCode, item.OwnerToken);
            meetings.RemoveAll(x => x.Meeting.ShortCode == item.Meeting.ShortCode);
        }
        catch (Exception ex) when (ex is ArgumentException or InvalidOperationException or UnauthorizedAccessException)
        {
            // TODO: показать сообщение пользователю через MudSnackbar.
            // Пока — молча, потому что встреча могла быть уже скрыта другим табом.
        }
    }

    private static string FormatGridRange(DateOnly start, DateOnly end)
    {
        if (start == end)
            return start.ToString("d MMMM yyyy", RussianCulture);

        if (start.Year == end.Year && start.Month == end.Month)
            return $"{start.Day}–{end.ToString("d MMMM yyyy", RussianCulture)}";

        if (start.Year == end.Year)
            return $"{start.ToString("d MMMM", RussianCulture)} – {end.ToString("d MMMM yyyy", RussianCulture)}";

        return $"{start.ToString("d MMMM yyyy", RussianCulture)} – {end.ToString("d MMMM yyyy", RussianCulture)}";
    }

    private static string FormatParticipantsCount(int count)
    {
        var lastTwo = count % 100;
        var lastOne = count % 10;
        var word = lastTwo is >= 11 and <= 14 ? "участников"
            : lastOne == 1 ? "участник"
            : lastOne is 2 or 3 or 4 ? "участника"
            : "участников";
        return $"{count} {word}";
    }

    private static string FormatSelectedInterval(Meeting meeting)
    {
        if (meeting.SelectedStartTime is null || meeting.SelectedEndTime is null)
            return string.Empty;

        var tz = TimeZoneInfo.FindSystemTimeZoneById(meeting.TimeZone);
        var start = TimeZoneInfo.ConvertTime(meeting.SelectedStartTime.Value, tz);
        var end = TimeZoneInfo.ConvertTime(meeting.SelectedEndTime.Value, tz);

        return start.Date == end.Date
            ? $"{start.ToString("d MMMM", RussianCulture)}, {start:HH:mm}–{end:HH:mm} ({meeting.TimeZone})"
            : $"{start.ToString("d MMMM HH:mm", RussianCulture)} – {end.ToString("d MMMM HH:mm", RussianCulture)} ({meeting.TimeZone})";
    }

    private static Color StatusColor(MeetingStatus status) =>
        status switch
        {
            MeetingStatus.Active => Color.Success,
            MeetingStatus.Closed => Color.Default,
            MeetingStatus.Archived => Color.Default,
            _ => Color.Default
        };

    private static string GetStatusText(MeetingStatus status) =>
        status switch
        {
            MeetingStatus.Active => "Активна",
            MeetingStatus.Closed => "Закрыта",
            MeetingStatus.Archived => "Архивирована",
            MeetingStatus.Deleted => "Удалена",
            _ => status.ToString()
        };

    private sealed record MeetingWithToken(Meeting Meeting, string OwnerToken);
}