<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <None Update="context.ai.txt">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>context.txt</DependentUpon>
    </None>
    <None Update="context.txt">
      <Generator>AiContextGenerator</Generator>
      <LastGenOutput>context.ai.txt</LastGenOutput>
    </None>
  </ItemGroup>

</Project>
